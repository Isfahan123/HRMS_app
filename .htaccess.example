# HRMS Web Application - Apache/cPanel Configuration Template
# ============================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .htaccess: cp .htaccess.example .htaccess
# 2. Replace YOUR_CPANEL_USERNAME with your actual cPanel username
# 3. Replace YOUR_APP_FOLDER with your app folder name (e.g., hrms or public_html)
# 4. Update Python version (3.11) to match your cPanel Python App version
#
# Example for user 'john' with app in 'hrms' folder using Python 3.11:
#   PassengerPython /home/john/virtualenv/hrms/3.11/bin/python
#   PassengerAppRoot /home/john/public_html/hrms

# Enable Passenger
PassengerEnabled On

# Python interpreter path - MUST UPDATE THIS
# Format: /home/YOUR_CPANEL_USERNAME/virtualenv/YOUR_APP_FOLDER/PYTHON_VERSION/bin/python
PassengerPython /home/YOUR_CPANEL_USERNAME/virtualenv/YOUR_APP_FOLDER/3.11/bin/python

# Application root - MUST UPDATE THIS
# Format: /home/YOUR_CPANEL_USERNAME/public_html/YOUR_APP_FOLDER (or subdomain path)
PassengerAppRoot /home/YOUR_CPANEL_USERNAME/public_html/YOUR_APP_FOLDER

# WSGI entry point - do not change
PassengerStartupFile passenger_wsgi.py

# Performance tuning
PassengerMinInstances 1
PassengerMaxPoolSize 4
PassengerStartTimeout 600

# Application environment
SetEnv ENVIRONMENT production

# Error pages
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Security headers
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set X-XSS-Protection "1; mode=block"

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Static file caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# Prevent directory listing
Options -Indexes

# Protect sensitive files (dotfiles, Python, logs, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
<FilesMatch "\.(env|py|pyc|log|ini|md|txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow passenger_wsgi.py (required by Passenger)
<Files "passenger_wsgi.py">
    Order allow,deny
    Allow from all
</Files>

# Allow static assets
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|woff|woff2|ttf|eot|ico)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# URL rewriting (optional)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Force HTTPS (uncomment if you have SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
