# HRMS Web Application - Apache/cPanel Configuration (Template)
# This file configures Apache to use Passenger for Python applications
# Compatible with Exabytes, cPanel, and other hosting providers
#
# SUBDOMAIN DEPLOYMENT INSTRUCTIONS:
# ==================================
# This application is designed to run on a subdomain (e.g., hrms.example.com)
# 
# To deploy on a subdomain:
# 1. Copy this file to .htaccess
# 2. Replace all {{PLACEHOLDER}} values:
#    - {{YOUR_CPANEL_USERNAME}}: Your cPanel account username (e.g., enigmagr)
#    - {{YOUR_SUBDOMAIN}}: Your subdomain name (e.g., hrms.example.com)
#    - {{YOUR_APP_FOLDER}}: The folder name where the app is deployed (e.g., HRMS_app)
#    - 3.11: Change if using a different Python version (3.9, 3.10, 3.12, etc.)
#
# Example for subdomain hrms.example.com:
#    PassengerPython /home/myuser/virtualenv/hrms.example.com/HRMS_app/3.11/bin/python
#    PassengerAppRoot /home/myuser/hrms.example.com/HRMS_app

# Enable Passenger
PassengerEnabled On

# Set the Python version (adjust based on your cPanel Python selector)
# Update the version number (3.11) to match your virtual environment
# Common paths: 3.9, 3.10, 3.11, 3.12
#
# IMPORTANT: Replace {{YOUR_CPANEL_USERNAME}}, {{YOUR_SUBDOMAIN}}, {{YOUR_APP_FOLDER}}
# Example: /home/myuser/virtualenv/hrms.example.com/HRMS_app/3.11/bin/python
PassengerPython /home/{{YOUR_CPANEL_USERNAME}}/virtualenv/{{YOUR_SUBDOMAIN}}/{{YOUR_APP_FOLDER}}/3.11/bin/python

# Set the application root
# IMPORTANT: Replace {{YOUR_CPANEL_USERNAME}}, {{YOUR_SUBDOMAIN}}, {{YOUR_APP_FOLDER}}
# Example: /home/myuser/hrms.example.com/HRMS_app
PassengerAppRoot /home/{{YOUR_CPANEL_USERNAME}}/{{YOUR_SUBDOMAIN}}/{{YOUR_APP_FOLDER}}

# Set the startup file (WSGI entry point)
PassengerStartupFile passenger_wsgi.py

# Performance tuning for Passenger
# Adjust based on your hosting plan resources
PassengerMinInstances 1
PassengerMaxPoolSize 4
PassengerStartTimeout 600

# Application environment
SetEnv ENVIRONMENT production

# Enable error pages
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Security headers
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set X-XSS-Protection "1; mode=block"

# Compression for static files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache static files
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(env|py|pyc|log|ini|md|txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow access to passenger_wsgi.py (required by Passenger)
<Files "passenger_wsgi.py">
    Order allow,deny
    Allow from all
</Files>

# Allow static files
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|woff|woff2|ttf|eot|ico)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Rewrite rules for clean URLs (if needed)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect www to non-www (optional)
    # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
    
    # Force HTTPS (recommended for production, uncomment if you have SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
