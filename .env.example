# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Web Application Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_RELOAD=false

# Application Environment
ENVIRONMENT=production

# Optional: Debug mode (set to true for troubleshooting)
# DEBUG=false

# SMTP Email Configuration
# Configure these to use your own email for sending notifications
# Example for custom domain email (admin@form.enigmagroup.com.my):
SMTP_SERVER=mail.enigmagroup.com.my
SMTP_PORT=587
SMTP_EMAIL=admin@form.enigmagroup.com.my
SMTP_PASSWORD=your_email_password_here
SMTP_SENDER_NAME=HRMS System
